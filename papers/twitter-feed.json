    {
      "id": "2085763890982306279",
      "handle": "allen_ai",
      "name": "Ai2",
      "avatar": "https://pbs.twimg.com/profile_images/1819065604370051072/UrIOp6zI_normal.png",
      "verified": false,
      "text": "Spelling out the trade-off in the prompt helps—every model we tested scores higher once told when to help vs. when to hold back.\nBut it only goes so far. Models still differ widely in how reliably they make that call, &amp; even the best scorers have plenty of room to improve.",
      "createdAt": "Fri Aug 07 16:23:57 +0000 2026",
      "permalink": "https://twitter.com/allen_ai/status/2085763890982306279",
      "media": [
